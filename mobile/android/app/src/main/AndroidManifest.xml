    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <application android:theme="@style/AppTheme" android:label="SDR 工作台" android:icon="@drawable/ic_launcher"
        android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
